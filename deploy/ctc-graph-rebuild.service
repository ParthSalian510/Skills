# Nightly rebuild of the case knowledge graph (Graphify). Triggered by ctc-graph-rebuild.timer.
# Logs: journalctl --user -u ctc-graph-rebuild · logs/graph.jsonl
[Unit]
Description=create-ticket-channel case graph rebuild (Graphify)

[Service]
Type=oneshot
WorkingDirectory=%h/.claude/skills/create-ticket-channel
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 scripts/rebuild_graph.py
